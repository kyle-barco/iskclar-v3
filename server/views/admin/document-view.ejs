<%- include('../partials/head', { title: doc.file_name + ' | Iskolarly' }) %>
<nav class="navbar navbar-admin">
  <div class="navbar-inner">
    <a href="/admin" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div>
        <div class="brand-title">Iskolarly</div>
        <div class="brand-sub"><%= adminRole === 'superadmin' ? 'Superadmin Portal' : 'Admin Portal' %></div>
      </div>
    </a>
    <div class="user">
      <span style="opacity:.7"><%= adminRole === 'superadmin' ? 'Super Administrator' : 'Administrator' %></span><strong><%= locals.adminName || 'Admin' %></strong>
      <div class="avatar"><%= (locals.adminName || 'A').charAt(0).toUpperCase() %></div>
      
    </div>
  </div>
</nav>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: 'applications', adminRole }) %>
  <main class="main-content">
    <div class="flex justify-between items-center mb-24">
      <div>
        <a href="<%= backUrl %>" class="btn btn-outline mb-16">&larr; Back</a>
        <h1 class="page-title" style="font-size:1.4rem;"><%= doc.file_name %></h1>
        <p class="text-muted text-sm">
          <%= doc.doc_type.replace(/_/g, ' ').replace(/\b\w/g, function(c){return c.toUpperCase();}) %>
          &middot; <%= doc.file_size_kb %> KB
          &middot; Uploaded <%= new Date(doc.created_at).toLocaleDateString() %>
        </p>
      </div>
      <a href="/admin/documents/<%= doc.id %>/download" class="btn btn-primary">Download</a>
    </div>
    <div class="card" style="padding:0;overflow:hidden;">
      <% if (doc.mime_type.startsWith('image/')) { %>
        <img src="/admin/documents/<%= doc.id %>/download" style="width:100%;max-height:80vh;object-fit:contain;display:block;" />
      <% } else { %>
        <iframe src="/admin/documents/<%= doc.id %>/download" style="width:100%;height:80vh;border:none;"></iframe>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>