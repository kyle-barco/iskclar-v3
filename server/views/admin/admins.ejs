<%- include('../partials/head', { title: 'Admin Users | Iskolarly' }) %>
<%- include('partials/navbar', { adminRole }) %>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: 'admins', adminRole }) %>
  <main class="main-content">
    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-top">
        <div>
          <div class="panel-title">User Accounts</div>
          <p style="opacity:.7;margin-top:4px;font-size:14px;">Manage administrators and their permissions.</p>
        </div>
      </div>
    </div>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="accounts-card">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h2>ADMINISTRATORS</h2>
        <button class="btn btn-sm btn-primary" onclick="document.getElementById('addAdminModal').style.display='block'">+ Add Admin</button>
      </div>
      <hr class="accounts-sep">

      <div id="addAdminModal" style="display:none;background:#f8f8f8;border-radius:12px;padding:18px;margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <h3 style="margin:0;">Add New Admin</h3>
          <button class="btn btn-sm btn-outline" onclick="document.getElementById('addAdminModal').style.display='none'">Close</button>
        </div>
        <form method="POST" action="/admin/admins" data-unsaved-warning>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
              <label>Email *</label>
              <input type="email" name="email" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Display Name *</label>
              <input type="text" name="display_name" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Password *</label>
              <input type="password" name="password" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Role</label>
              <select name="role" class="form-control">
                <option value="admin">Admin</option>
                <option value="superadmin">Superadmin</option>
              </select>
            </div>
          </div>
          <div style="margin-top:12px;">
            <button type="submit" class="btn btn-primary">Create Admin</button>
          </div>
        </form>
      </div>

      <% if (!admins || admins.filter(function(a) { return a.role !== 'superadmin'; }).length === 0) { %>
        <p class="text-muted" style="text-align:center;padding:24px;">No admin users found.</p>
      <% } else { %>
        <% var colors = ['#9b59b6','#f08245','#ff4fa0','#5dade2','#e74c3c','#2ecc71','#3498db']; %>
        <% var ci = 0; %>
        <% admins.filter(function(a) { return a.role !== 'superadmin'; }).forEach(function(a) { %>
          <div class="user-row">
            <div class="user-left">
              <div class="user-badge-sm" style="background:<%= colors[ci++ % colors.length] %>"><%= a.display_name.charAt(0).toUpperCase() %></div>
              <strong><%= a.display_name %></strong>
            </div>
            <div class="user-btns">
              <form method="POST" action="/admin/admins/<%= a.id %>/toggle-active" style="display:inline;">
                <button type="submit" class="user-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z"/><path d="M8 12h8"/></svg>
                  <%= a.is_active ? 'SUSPEND' : 'ACTIVATE' %>
                </button>
              </form>
              <form method="POST" action="/admin/admins/<%= a.id %>/delete" style="display:inline;" data-confirm-delete="Delete this admin? This action cannot be undone.">
                <button type="submit" class="user-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  REMOVE
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>