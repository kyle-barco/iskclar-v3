<%- include('../partials/head', { title: 'Admin Users | Iskolarly' }) %>
<nav class="navbar">
  <div class="navbar-inner">
    <a href="/admin" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div class="brand-text">Iskolarly<span class="sub">Admin</span></div>
    </a>
    <ul class="nav-links">
      <li><a href="/admin">Dashboard</a></li>
      <li><a href="/admin/applications">Applications</a></li>
      <li><a href="/admin/students">Students</a></li>
      <li><a href="/auth/logout">Log Out</a></li>
    </ul>
  </div>
</nav>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: 'admins', adminRole }) %>
  <main class="main-content">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
      <h1 style="font-size:1.8rem;margin:0;">Admin Users</h1>
      <button class="btn btn-primary" onclick="document.getElementById('addAdminModal').style.display='block'">Add Admin</button>
    </div>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div id="addAdminModal" class="card mb-32" style="display:none;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 style="margin:0;">Add New Admin</h3>
        <button class="btn btn-sm" onclick="document.getElementById('addAdminModal').style.display='none'">Close</button>
      </div>
      <form method="POST" action="/admin/admins">
        <div class="grid-2 gap-16">
          <div class="form-group">
            <label class="form-label">Email *</label>
            <input type="email" name="email" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Display Name *</label>
            <input type="text" name="display_name" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Password *</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Role</label>
            <select name="role" class="form-control">
              <option value="admin">Admin</option>
              <option value="superadmin">Superadmin</option>
            </select>
          </div>
        </div>
        <div class="mt-16">
          <button type="submit" class="btn btn-primary">Create Admin</button>
        </div>
      </form>
    </div>

    <% if (admins.length === 0) { %>
      <div class="alert alert-info">No admin users found.</div>
    <% } else { %>
      <div class="card">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Display Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% admins.forEach(function(a) { %>
              <tr>
                <td><%= a.display_name %></td>
                <td><%= a.email %></td>
                <td>
                  <span class="badge <%= a.role === 'superadmin' ? 'badge-gold' : 'badge-active' %>"><%= a.role %></span>
                </td>
                <td>
                  <span class="badge <%= a.is_active ? 'badge-active' : 'badge-inactive' %>"><%= a.is_active ? 'Active' : 'Inactive' %></span>
                </td>
                <td>
                  <form method="POST" action="/admin/admins/<%= a.id %>/toggle-active" style="display:inline;">
                    <button type="submit" class="btn btn-sm <%= a.is_active ? 'btn-warning' : 'btn-success' %>"><%= a.is_active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <form method="POST" action="/admin/admins/<%= a.id %>/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this admin?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                  <% if (a.role === 'superadmin' && admins.filter(function(x) { return x.role === 'superadmin' && x.is_active; }).length <= 1) { %>
                    <small style="display:block;color:var(--text-muted);margin-top:4px;">Cannot delete last active superadmin</small>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>
</div>
</body>
</html>
