<nav class="navbar navbar-admin">
  <div class="navbar-inner">
    <a href="/admin" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div>
        <div class="brand-title">Iskolarly</div>
        <div class="brand-sub"><%= adminRole === 'superadmin' ? 'Superadmin Portal' : 'Admin Portal' %></div>
      </div>
    </a>
    <div class="user">
      <span style="opacity:.7"><%= adminRole === 'superadmin' ? 'Super Administrator' : 'Administrator' %></span>
      <strong><%= locals.adminName || 'Admin' %></strong>
      <div class="avatar admin-avatar" onclick="toggleAdminDropdown(event)" style="position:relative;cursor:pointer;">
        <%= (locals.adminName || 'A').charAt(0).toUpperCase() %>
        <div class="admin-dropdown" id="adminDropdown">
          <div class="admin-dropdown-header">
            <div class="admin-dropdown-avatar"><%= (locals.adminName || 'A').charAt(0).toUpperCase() %></div>
            <div>
              <div class="admin-dropdown-name"><%= locals.adminName || 'Admin' %></div>
              <span class="admin-dropdown-role <%= adminRole %>"><%= adminRole === 'superadmin' ? 'Super Admin' : 'Admin' %></span>
            </div>
          </div>
          <div class="admin-dropdown-divider"></div>
          <% if (adminRole === 'superadmin') { %>
          <a href="/admin/admins" class="admin-dropdown-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Admin Users
          </a>
          <a href="/admin/reports" class="admin-dropdown-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="m16 13-3.5 3.5-2-2L8 17"/></svg>
            Reports & Analytics
          </a>
          <div class="admin-dropdown-divider"></div>
          <% } %>
          <a href="/auth/logout" class="admin-dropdown-item admin-dropdown-logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Log Out
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
<script>
function toggleAdminDropdown(e) {
  e.stopPropagation();
  var dd = document.getElementById('adminDropdown');
  dd.classList.toggle('open');
}
document.addEventListener('click', function() {
  var dd = document.getElementById('adminDropdown');
  if (dd) dd.classList.remove('open');
});
</script>