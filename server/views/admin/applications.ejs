<%- include('../partials/head', { title: 'Applications | Iskolarly' }) %>
<nav class="navbar">
  <div class="navbar-inner">
    <a href="/admin" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div class="brand-text">Iskolarly<span class="sub">Admin</span></div>
    </a>
    <ul class="nav-links">
      <li><a href="/admin">Dashboard</a></li>
      <li><a href="/admin/students">Students</a></li>
      <li><a href="/auth/logout">Log Out</a></li>
    </ul>
  </div>
</nav>
<% var badgeClass = { pending: 'badge-pending', approved: 'badge-approved', rejected: 'badge-rejected', under_review: 'badge-review', waitlisted: 'badge-gold' }; %>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: 'applications', adminRole }) %>
  <main class="main-content">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
      <h1 style="font-size:1.8rem;margin:0;">Applications</h1>
      <button class="btn btn-outline" disabled style="opacity:.5;cursor:not-allowed;">Export</button>
    </div>
    <form method="GET" action="/admin/applications" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;margin-bottom:24px;">
      <div class="form-group" style="margin-bottom:0;">
        <label class="text-sm" style="font-size:.78rem;">Status</label>
        <select name="status" class="form-control">
          <option value="" <%= !statusFilter ? 'selected' : '' %>>All Statuses</option>
          <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="under_review" <%= statusFilter === 'under_review' ? 'selected' : '' %>>Under Review</option>
          <option value="approved" <%= statusFilter === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="rejected" <%= statusFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
          <option value="waitlisted" <%= statusFilter === 'waitlisted' ? 'selected' : '' %>>Waitlisted</option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label class="text-sm" style="font-size:.78rem;">Search</label>
        <input type="text" name="search" class="form-control" placeholder="Search by name..." value="<%= search || '' %>" />
      </div>
      <button type="submit" class="btn btn-primary">Filter</button>
      <a href="/admin/applications" class="btn btn-outline">Clear</a>
    </form>
    <% if (!applications || applications.length === 0) { %>
      <div class="alert alert-warn">No applications found.</div>
    <% } else { %>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Student ID</th>
              <th>Program</th>
              <th>Academic Year</th>
              <th>Status</th>
              <th>Date Applied</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(function(app) { %>
            <tr>
              <td><%= app.student.first_name %> <%= app.student.last_name %></td>
              <td><%= app.student.student_id %></td>
              <td><%= app.program.name %></td>
              <td><%= app.academic_year %> - <%= app.semester %></td>
              <td><span class="badge <%= badgeClass[app.status] %>"><%= app.status.replace('_', ' ') %></span></td>
              <td><%= new Date(app.created_at).toLocaleDateString() %></td>
              <td>
                <form method="POST" action="/admin/applications/<%= app.id %>" style="display:flex;gap:4px;align-items:center;">
                  <select name="status" class="form-control" style="padding:5px 8px;font-size:.75rem;width:auto;">
                    <option value="" disabled>Change status</option>
                    <option value="under_review" <%= app.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
                    <option value="approved" <%= app.status === 'approved' ? 'selected' : '' %>>Approved</option>
                    <option value="rejected" <%= app.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                    <option value="waitlisted" <%= app.status === 'waitlisted' ? 'selected' : '' %>>Waitlisted</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-primary">Update</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
