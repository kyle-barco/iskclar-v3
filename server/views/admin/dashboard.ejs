<%- include('../partials/head', { title: 'Dashboard | Iskolarly' }) %>
<%- include('partials/navbar', { adminRole }) %>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: 'dashboard', adminRole }) %>
  <main class="main-content">
    <div class="dashboard-banner">
      <h1><%= adminRole === 'superadmin' ? 'Superadmin Dashboard' : 'Admin Dashboard' %></h1>
      <p><%= adminRole === 'superadmin' ? 'Full system oversight. Manage admins, view reports, and control all operations.' : 'Welcome back. Here\'s an overview of scholarship operations.' %></p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">✓</div>
        <div>
          <div class="stat-number"><%= stats.approved %></div>
          <div class="stat-label">APPROVED APPLICATIONS</div>
          <div class="stat-change">↑ active scholars</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">⌕</div>
        <div>
          <div class="stat-number"><%= stats.pending + stats.under_review %></div>
          <div class="stat-label">UNDER EVALUATION</div>
          <div class="stat-change"><%= stats.pending %> pending / <%= stats.under_review %> under review</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">✕</div>
        <div>
          <div class="stat-number"><%= stats.rejected %></div>
          <div class="stat-label">REJECTED</div>
          <div class="stat-change"><%= stats.rejected > 0 ? Math.round(stats.rejected / (stats.approved || 1) * 100) : 0 %>% rejection rate</div>
        </div>
      </div>
    </div>

    <div class="table-card">
      <div class="card-header">
        <h3>Recent Applications</h3>
        <a href="/admin/applications">View All →</a>
      </div>
      <% if (recentApplications && recentApplications.length) { %>
        <% recentApplications.forEach(function(app) { %>
          <% 
            var initial = (app.student.first_name || 'A').charAt(0).toUpperCase();
            var badgeClass = 'pending';
            if (app.status === 'approved') badgeClass = 'approved';
            else if (app.status === 'under_review') badgeClass = 'evaluating';
            else if (app.status === 'waitlisted') badgeClass = 'evaluating';
            else if (app.status === 'rejected') badgeClass = 'rejected';
            var colorClass = 'yellow';
            if (['approved','evaluating'].includes(app.status)) colorClass = 'blue';
            else if (app.status === 'rejected') colorClass = 'red';
          %>
          <div class="application-item">
            <div class="left">
              <div class="user-badge <%= colorClass %>"><%= initial %></div>
              <div class="application-info">
                <strong><%= app.student.first_name %> <%= app.student.last_name %></strong>
                <span><%= app.program.name %></span>
              </div>
            </div>
            <div class="status-pill <%= badgeClass %>"><%= app.status.replace('_', ' ') %></div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-muted" style="padding:18px;text-align:center;">No recent applications.</p>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>