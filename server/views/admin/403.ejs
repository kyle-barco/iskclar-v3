<%- include('../partials/head', { title: '403 Forbidden | Iskolarly' }) %>
<nav class="navbar navbar-admin">
  <div class="navbar-inner">
    <a href="/admin" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div>
        <div class="brand-title">Iskolarly</div>
        <div class="brand-sub">Admin Portal</div>
      </div>
    </a>
    <div class="user">
      <span style="opacity:.7">Administrator</span><strong><%= locals.adminName || 'Admin' %></strong>
      <div class="avatar"><%= (locals.adminName || 'A').charAt(0).toUpperCase() %></div>
      
    </div>
  </div>
</nav>
<div class="dashboard-layout">
  <%- include('partials/sidebar', { currentPage: null, adminRole }) %>
  <main class="main-content" style="display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 64px);">
    <div style="text-align:center;padding:60px 40px;background:#fff;border-radius:20px;box-shadow:0 4px 20px rgba(0,0,0,.08);max-width:460px;">
      <div style="font-size:96px;font-weight:800;color:var(--navy);line-height:1;margin-bottom:8px;">403</div>
      <div style="font-size:24px;font-weight:700;color:#333;margin-bottom:8px;">Access Denied</div>
      <p style="color:#888;margin-bottom:28px;font-size:15px;">You do not have the required permissions to access this page. If you believe this is a mistake, contact your system administrator.</p>
      <a href="/admin" style="display:inline-block;padding:12px 32px;background:var(--navy);color:#fff;border-radius:10px;text-decoration:none;font-weight:600;">Back to Dashboard</a>
    </div>
  </main>
</div>
</body>
</html>
