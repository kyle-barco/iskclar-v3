<%- include('partials/head', { title: 'Iskolarly', fonts: true }) %>
<%- include('partials/navbar', {
  navLinks: [
    { href: '#home', label: 'Home' },
    { href: '#how-it-works', label: 'How It Works' },
    { href: '#contact', label: 'Contact' },
    { href: '/auth/login', label: 'Log In' },
    { href: '/auth/register', label: 'Apply Now', cls: 'nav-cta' }
  ]
}) %>

<section class="page-hero hero-landing">
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge">Scholarship Management System</div>
      <h1>Your Future, <em>Funded.</em><br>Apply with Confidence.</h1>
      <p style="color:rgba(255,255,255,.72);font-size:1.1rem;max-width:520px;line-height:1.7;">
        Iskolarly is a centralized scholarship management platform connecting deserving students with financial support all in one place.
      </p>
      <div class="hero-actions">
        <a href="/auth/register" class="btn btn-gold btn-lg">Create an Account</a>
        <a href="/auth/login" class="btn btn-outline-white btn-lg">Student Login</a>
      </div>
    </div>
  </div>
</section>

<div style="background:var(--warn-bg);border-bottom:1px solid #F5C06A;padding:12px 0;">
  <div class="container flex items-center gap-16 justify-between wrap">
    <div class="flex items-center gap-12">
      <span style="font-size:1.1rem;">📢</span>
      <p style="font-size:.875rem;color:#7A4A04;font-weight:500;">
        <strong>AY 2025–2026 Scholarship Applications</strong> are now open.
      </p>
    </div>
    <a href="/auth/register" class="btn btn-sm" style="background:var(--warn);color:var(--white);border-color:var(--warn);">Apply Now →</a>
  </div>
</div>

<section id="how-it-works" style="padding:80px 0;">
  <div class="container">
    <div class="text-center mb-48">
      <div class="eyebrow" style="display:inline-block;background:rgba(201,168,76,.15);color:#B45309;border:1px solid rgba(201,168,76,.3);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 14px;border-radius:12px;margin-bottom:12px;">Process Overview</div>
      <h2 style="font-size:2rem;margin-bottom:10px;">From Application to Approval</h2>
      <p class="text-muted" style="max-width:520px;margin:0 auto;">A transparent, step-by-step process designed for students and administrators alike.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;">
      <div class="ribbon-card" style="padding:28px 28px 28px 36px;">
        <div style="font-size:1.8rem;margin-bottom:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#EBB11F" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-notebook-pen-icon lucide-notebook-pen"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/></svg></div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Step 01</div>
        <h4 style="margin-bottom:8px;">Register & Create Account</h4>
        <p style="font-size:.85rem;color:var(--muted);line-height:1.6;">Sign up with your personal details and verify your student status to access the portal.</p>
      </div>
      <div class="ribbon-card" style="padding:28px 28px 28px 36px;">
        <div style="font-size:1.8rem;margin-bottom:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#EBB11F" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list-icon lucide-clipboard-list"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg></div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Step 02</div>
        <h4 style="margin-bottom:8px;">Fill Out Application</h4>
        <p style="font-size:.85rem;color:var(--muted);line-height:1.6;">Complete the scholarship application form and upload required documents securely.</p>
      </div>
      <div class="ribbon-card" style="padding:28px 28px 28px 36px;">
        <div style="font-size:1.8rem;margin-bottom:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#EBB11F" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg></div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Step 03</div>
        <h4 style="margin-bottom:8px;">Admin Review & Evaluation</h4>
        <p style="font-size:.85rem;color:var(--muted);line-height:1.6;">Our team reviews your documents and evaluates eligibility based on set scholarship criteria.</p>
      </div>
      <div class="ribbon-card" style="padding:28px 28px 28px 36px;">
        <div style="font-size:1.8rem;margin-bottom:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#EBB11F" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-check-big-icon lucide-square-check-big"><path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.344"/><path d="m9 11 3 3L22 4"/></svg></div>
        <div style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;">Step 04</div>
        <h4 style="margin-bottom:8px;">Receive Decision & Onboarding</h4>
        <p style="font-size:.85rem;color:var(--muted);line-height:1.6;">Get notified of your result. Approved scholars are onboarded into the scholars' database.</p>
      </div>
    </div>
  </div>
</section>

<section style="padding:80px 0;background-color:#360D0E;">
  <div class="container">
    <div class="grid-2" style="gap:60px;align-items:center;">
      <div>
        <div style="display:inline-block;background:rgba(201,168,76,.15);border:1px solid rgba(201,168,76,.3);color:var(--gold2);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 14px;border-radius:12px;margin-bottom:16px;">Why Iskolarly</div>
        <h2 style="color:#FCFFFD;font-size:1.9rem;margin-bottom:16px;">Everything You Need, In One System</h2>
        <p style="color:#CABBBB;line-height:1.7;margin-bottom:28px;">We built Iskolarly to eliminate paperwork chaos, reduce manual errors, and give every stakeholder real-time visibility into the scholarship pipeline.</p>
        <div style="display:flex;flex-direction:column;gap:16px;">
          <div class="flex items-start gap-16">
            <div style="width:40px;height:40px;background:rgba(255,121,121,.273);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole-icon lucide-lock-keyhole"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg></div>
            <div><h4 style="color:#FCFFFD;margin-bottom:4px;">Secure Document Uploads</h4><p style="font-size:.85rem;color:#CABBBB;">All documents are securely uploaded and stored. Only authorized personnel can view sensitive files.</p></div>
          </div>
          <div class="flex items-start gap-16">
            <div style="width:40px;height:40px;background:rgba(255,121,121,.273);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell-check-icon lucide-bell-check"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="m15 8 2 2 4-4"/><path d="M16.8607 4.4824A6 6 0 0 0 6 8C6 12.499 4.589 13.956 3.262 15.326"/><path d="M3.262 15.326A1 1 0 0 0 4 17H20A1 1 0 0 0 20.74 15.327C20.209 14.779 19.665 14.218 19.203 13.454"/></svg></div>
            <div><h4 style="color:#FCFFFD;margin-bottom:4px;">Real-Time Notifications</h4><p style="font-size:.85rem;color:#CABBBB;">Applicants receive immediate updates on every stage of their application via the portal and email.</p></div>
          </div>
          <div class="flex items-start gap-16">
            <div style="width:40px;height:40px;background:rgba(255,121,121,.273);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-chart-column-increasing-icon lucide-file-chart-column-increasing"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M8 18v-2"/><path d="M12 18v-4"/><path d="M16 18v-6"/></svg></div>
            <div><h4 style="color:#FCFFFD;margin-bottom:4px;">Analytics & Reports</h4><p style="font-size:.85rem;color:#CABBBB;">Administrators gain full visibility with dashboards, fund tracking, and exportable data reports.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="padding:80px 0;" id="contact">
  <div class="container-md">
    <div class="text-center mb-48">
      <h2 style="font-size:2rem;margin-bottom:8px;">Frequently Asked Questions</h2>
      <p class="text-muted">Everything you need to know about applying through Iskolarly.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:12px;">
      <div class="faq-item card card-sm" style="cursor:pointer;">
        <div class="flex justify-between items-center" onclick="this.parentElement.querySelector('.faq-answer').style.display='block'">
          <h4 style="font-size:.9rem;">Who is eligible to apply for a scholarship?</h4>
          <span class="faq-icon" style="font-size:1.2rem;color:var(--muted);">+</span>
        </div>
        <div class="faq-answer" style="display:none;margin-top:12px;font-size:.875rem;color:var(--muted);line-height:1.7;">Eligibility varies per scholarship program. Generally, applicants must be currently enrolled students in good academic standing.</div>
      </div>
      <div class="faq-item card card-sm" style="cursor:pointer;">
        <div class="flex justify-between items-center" onclick="this.parentElement.querySelector('.faq-answer').style.display='block'">
          <h4 style="font-size:.9rem;">What documents are required for application?</h4>
          <span class="faq-icon" style="font-size:1.2rem;color:var(--muted);">+</span>
        </div>
        <div class="faq-answer" style="display:none;margin-top:12px;font-size:.875rem;color:var(--muted);line-height:1.7;">Typical requirements include: certified true copy of grades, proof of enrollment, proof of household income, government-issued ID, and a personal essay.</div>
      </div>
      <div class="faq-item card card-sm" style="cursor:pointer;">
        <div class="flex justify-between items-center" onclick="this.parentElement.querySelector('.faq-answer').style.display='block'">
          <h4 style="font-size:.9rem;">How long does the application process take?</h4>
          <span class="faq-icon" style="font-size:1.2rem;color:var(--muted);">+</span>
        </div>
        <div class="faq-answer" style="display:none;margin-top:12px;font-size:.875rem;color:var(--muted);line-height:1.7;">After submission, the review process typically takes 5&ndash;10 business days.</div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
