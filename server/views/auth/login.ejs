<%- include('../partials/head', { title: 'Login | Iskolarly' }) %>

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div class="brand-text">Iskolarly</div>
    </a>
    <ul class="nav-links">
      <li><a href="/">&larr; Back to Home</a></li>
      <li><a href="/auth/admin">Admin Portal</a></li>
    </ul>
  </div>
</nav>

<div style="min-height:calc(100vh - 64px);display:grid;grid-template-columns:1fr 1fr;">
  <div style="background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%);display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:64px 56px;position:relative;overflow:hidden;">
    <div style="position:absolute;top:-80px;right:-80px;width:280px;height:280px;background:rgba(201,168,76,.1);border-radius:50%;"></div>
    <div style="position:absolute;bottom:-60px;left:20%;width:180px;height:180px;background:rgba(201,168,76,.06);border-radius:50%;"></div>
    <h2 style="color:var(--white);font-size:2rem;margin-bottom:14px;position:relative;z-index:1;">Welcome Back, Scholar.</h2>
    <p style="color:rgba(255,255,255,.65);font-size:.95rem;line-height:1.7;max-width:360px;margin-bottom:40px;position:relative;z-index:1;">Access your application dashboard, track your scholarship status, and manage your academic records.</p>
    <div style="display:flex;flex-direction:column;gap:16px;position:relative;z-index:1;">
      <div class="flex items-center gap-12"><div style="width:32px;height:32px;background:rgba(201,168,76,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg></div><span style="color:rgba(255,255,255,.75);font-size:.875rem;">Track your application in real-time</span></div>
      <div class="flex items-center gap-12"><div style="width:32px;height:32px;background:rgba(201,168,76,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M2 11.5V5a2 2 0 0 1 2-2h3.9c.7 0 1.3.3 1.7.9l.8 1.2c.4.6 1 .9 1.7.9H20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-9.5"/><path d="M11.378 13.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/></svg></div><span style="color:rgba(255,255,255,.75);font-size:.875rem;">Upload and manage required documents</span></div>
      <div class="flex items-center gap-12"><div style="width:32px;height:32px;background:rgba(201,168,76,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M22 8c0-2.3-.8-4.3-2-6"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/></svg></div><span style="color:rgba(255,255,255,.75);font-size:.875rem;">Receive instant status notifications</span></div>
      <div class="flex items-center gap-12"><div style="width:32px;height:32px;background:rgba(201,168,76,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem;"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></div><span style="color:rgba(255,255,255,.75);font-size:.875rem;">Submit renewal requirements easily</span></div>
    </div>
  </div>

  <div style="display:flex;align-items:center;justify-content:center;padding:48px 40px;background:var(--slate);">
    <div style="width:100%;max-width:420px;">
      <h1 style="font-size:1.7rem;margin-bottom:6px;">Student Login</h1>
      <p class="text-muted mb-32">Sign in to access your scholarship dashboard.</p>

      <% if (locals.error) { %>
      <div class="alert alert-info mb-24" style="display:flex;">
        <span class="alert-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#222222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert-icon lucide-triangle-alert"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
        <div><%= error %></div>
      </div>
      <% } %>

      <% if (locals.message) { %>
      <div class="alert alert-success mb-24" style="display:flex;">
        <span class="alert-icon">✅</span>
        <div><%= message %></div>
      </div>
      <% } %>

      <form method="POST" action="/auth/login">
        <div class="form-group">
          <label>Username or Email <span class="required">*</span></label>
          <input type="text" class="form-control" name="username" placeholder="Enter your username or email" required />
        </div>
        <div class="form-group">
          <label>Password <span class="required">*</span></label>
          <div style="position:relative;">
            <input type="password" class="form-control" name="password" id="loginPassword" placeholder="Enter your password" required style="padding-right:44px;" />
            <button type="button" onclick="togglePassword()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--muted);display:flex;align-items:center;font-size:1.1rem;" aria-label="Toggle password visibility">
              <span id="loginPassIcon">👁</span>
            </button>
          </div>
        </div>
        <div class="flex justify-between items-center mb-24" style="margin-top:-8px;">
          <div class="check-group">
            <input type="checkbox" name="rememberMe" id="rememberMe" value="true" checked />
            <label for="rememberMe" style="font-weight:400;font-size:.82rem;">Remember me</label>
          </div>
          <a href="#" style="font-size:.82rem;color:var(--navy);font-weight:600;">Forgot Password?</a>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-full">Log In to My Account</button>
      </form>

      <div style="display:flex;align-items:center;gap:12px;margin:24px 0;">
        <hr style="flex:1;border:none;border-top:1px solid var(--border);" />
        <span style="font-size:.8rem;color:var(--muted);">or</span>
        <hr style="flex:1;border:none;border-top:1px solid var(--border);" />
      </div>

      <div class="text-center">
        <p class="text-muted text-sm mb-8">Don't have an account yet?</p>
        <a href="/auth/register" class="btn btn-outline w-full">Create an Account</a>
      </div>

      <hr class="divider" />
      <div class="text-center">
        <p style="font-size:.8rem;color:var(--muted);">Are you an Administrator?</p>
        <a href="/auth/admin" style="color:var(--navy);font-size:.85rem;font-weight:600;">Go to Admin Portal &rarr;</a>
      </div>
    </div>
  </div>
</div>
<script>
  function togglePassword() {
    const el = document.getElementById('loginPassword');
    const icon = document.getElementById('loginPassIcon');
    if (el.type === 'password') {
      el.type = 'text';
      icon.textContent = '🙈';
    } else {
      el.type = 'password';
      icon.textContent = '👁';
    }
  }
</script>
</body>
</html>
