<%- include('../partials/head', { title: 'Forgot Password | Iskolarly' }) %>

<div class="admin-portal-wrap">
  <div style="text-align:center;margin-bottom:32px;">
    <a href="/" class="navbar-brand" style="justify-content:center;display:inline-flex;">
      <div class="brand-icon" style="width:48px;height:48px;font-size:1.4rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
      </div>
      <div class="brand-text" style="text-align:left;">
        Iskolarly
        <span class="sub">Password Reset</span>
      </div>
    </a>
  </div>

  <div class="card admin-portal-card" style="width:100%;max-width:440px;">
    <div style="text-align:center;margin-bottom:24px;">
      <div style="width:56px;height:56px;background:var(--navy);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 14px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <h2 style="font-size:1.4rem;margin-bottom:4px;">Forgot Password</h2>
      <p style="color:var(--muted);font-size:.85rem;">
        <% if (locals.admin) { %>
          Enter your admin email and we'll send you a reset link.
        <% } else { %>
          Enter your email and we'll send you a reset link.
        <% } %>
      </p>
    </div>

    <% if (locals.error) { %>
    <div style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;border-radius:var(--radius);padding:12px 14px;font-size:.875rem;margin-bottom:16px;"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
    <div style="background:#dcfce7;color:#166534;border:1px solid #86efac;border-radius:var(--radius);padding:12px 14px;font-size:.875rem;margin-bottom:16px;"><%= success %></div>
    <% } %>

    <form method="POST" action="<%= locals.admin ? '/auth/admin/forgot-password' : '/auth/forgot-password' %>">
      <div class="form-group">
        <label>Email Address <span class="required">*</span></label>
        <input type="email" class="form-control" name="email" placeholder="Enter your email" value="<%= locals.email || '' %>" required autofocus />
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-full mt-8">Send Reset Link</button>
    </form>

    <hr class="divider" />
    <div class="text-center">
      <a href="<%= locals.admin ? '/auth/admin' : '/auth/login' %>" style="font-size:.85rem;color:var(--muted);">&larr; Back to Sign In</a>
    </div>
  </div>
</div>
</body>
</html>
