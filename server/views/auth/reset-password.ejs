<%- include('../partials/head', { title: 'Reset Password | Iskolarly' }) %>

<div class="admin-portal-wrap">
  <div style="text-align:center;margin-bottom:32px;">
    <a href="/" class="navbar-brand" style="justify-content:center;display:inline-flex;">
      <div class="brand-icon" style="width:48px;height:48px;font-size:1.4rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
      </div>
      <div class="brand-text" style="text-align:left;">
        Iskolarly
        <span class="sub">Set New Password</span>
      </div>
    </a>
  </div>

  <div class="card admin-portal-card" style="width:100%;max-width:440px;">
    <div style="text-align:center;margin-bottom:24px;">
      <div style="width:56px;height:56px;background:var(--navy);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 14px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h2 style="font-size:1.4rem;margin-bottom:4px;">Set New Password</h2>
      <p style="color:var(--muted);font-size:.85rem;">Choose a strong password you haven't used before.</p>
    </div>

    <% if (locals.error) { %>
    <div style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;border-radius:var(--radius);padding:12px 14px;font-size:.875rem;margin-bottom:16px;"><%= error %></div>
    <% } %>

    <% if (locals.success) { %>
    <div style="background:#dcfce7;color:#166534;border:1px solid #86efac;border-radius:var(--radius);padding:12px 14px;font-size:.875rem;margin-bottom:16px;">
      <%= success %>
    </div>
    <div class="text-center">
      <a href="/auth/login" style="font-size:.9rem;color:var(--navy);font-weight:600;">Go to Sign In &rarr;</a>
    </div>
    <% } else { %>
    <form method="POST" action="/auth/reset-password/<%= locals.token %>">
      <div class="form-group">
        <label>New Password <span class="required">*</span></label>
        <div style="position:relative;">
          <input type="password" class="form-control" name="password" id="newPassword" placeholder="Enter new password" required style="padding-right:44px;" minlength="8" />
          <button type="button" onclick="tp('newPassword')" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.1rem;">👁</button>
        </div>
      </div>
      <div class="form-group">
        <label>Confirm Password <span class="required">*</span></label>
        <div style="position:relative;">
          <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" placeholder="Confirm new password" required style="padding-right:44px;" minlength="8" />
          <button type="button" onclick="tp('confirmPassword')" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.1rem;">👁</button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-full mt-8">Reset Password</button>
    </form>
    <% } %>
  </div>
</div>
<script>
function tp(id) {
  var el = document.getElementById(id);
  el.type = el.type === 'password' ? 'text' : 'password';
}
</script>
</body>
</html>
