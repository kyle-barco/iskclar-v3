<%- include('../partials/head', { title: 'Admin | Iskolarly' }) %>

<div class="admin-portal-wrap">
  <div style="text-align:center;margin-bottom:32px;">
    <a href="/" class="navbar-brand" style="justify-content:center;display:inline-flex;">
      <div class="brand-icon" style="width:48px;height:48px;font-size:1.4rem;"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div class="brand-text" style="text-align:left;">
        Iskolarly
        <span class="sub">Administrator Portal</span>
      </div>
    </a>
  </div>

  <div class="card admin-portal-card" style="width:100%;max-width:440px;">
    <div style="text-align:center;margin-bottom:24px;">
      <div style="width:56px;height:56px;background:var(--navy);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin:0 auto 14px;"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole-icon lucide-lock-keyhole"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg></div>
      <h2 style="font-size:1.4rem;margin-bottom:4px;">Admin Sign In</h2>
    </div>

    <% if (locals.error) { %>
    <div style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;border-radius:var(--radius);padding:12px 14px;font-size:.875rem;margin-top:8px;"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/admin">
      <div class="form-group">
        <label>Administrator Email <span class="required">*</span></label>
        <input type="text" class="form-control" name="username" placeholder="Enter your admin email" required />
      </div>
      <div class="form-group">
        <label>Password <span class="required">*</span></label>
        <input type="password" class="form-control" name="password" placeholder="Enter your password" required />
      </div>
      <div class="form-group">
        <label>Role <span class="required">*</span></label>
        <select class="form-control" name="role">
          <option value="">Select your role</option>
          <option value="admin">Administrator</option>
          <option value="superadmin">Super Administrator</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-full mt-8">Sign In to Admin Portal</button>
    </form>

    <hr class="divider" />
    <div class="text-center">
      <a href="/auth/login" style="font-size:.85rem;color:var(--muted);">&larr; Back to Student Log in</a>
    </div>
  </div>
</div>
</body>
</html>
