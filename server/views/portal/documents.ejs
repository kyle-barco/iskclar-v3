<%- include('../partials/head', { title: 'Documents | Iskolarly' }) %>

<nav class="navbar navbar-portal">
  <div class="navbar-inner">
    <a href="/portal" class="navbar-brand">
      <div class="brand-icon"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap-icon lucide-graduation-cap"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg></div>
      <div class="brand-text">Iskolarly<span class="sub">Student Portal</span></div>
    </a>
    <div class="navbar-user">
      <span class="user-name"><%= student.first_name %> <%= student.last_name %></span>
      <div class="user-avatar"><%= (student.first_name || '?')[0].toUpperCase() %></div>
    </div>
  </div>
</nav>

<div class="dashboard-layout">
  <%- include('../partials/student-sidebar', { active: 'documents' }) %>

  <main class="main-content">
    <div class="page-hero" style="margin:-32px -32px 32px;border-radius:0;padding:36px 32px 32px;">
      <div class="eyebrow">Document Center</div>
      <h1 style="font-size:1.8rem;">My Documents</h1>
      <p>Upload and manage documents for your scholarship applications.</p>
    </div>

    <% if (locals.error) { %>
    <div class="alert alert-danger mb-24"><%= error %></div>
    <% } %>
    <% if (locals.message) { %>
    <div class="alert alert-success mb-24"><%= message %></div>
    <% } %>

    <div class="grid-4 mb-32">
      <div class="stat-card">
        <div class="card-icon gold" style="background:rgba(94,0,6,0.3);width:44px;height:44px;font-size:1.1rem;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-icon lucide-file"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg></div>
        <div><div class="stat-value"><%= documents.length %></div><div class="stat-label">Total Documents</div></div>
      </div>
      <div class="stat-card">
        <div class="card-icon green" style="background:rgba(94,0,6,0.3);width:44px;height:44px;font-size:1.1rem;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open-icon lucide-folder-open"><path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/></svg></div>
        <div><div class="stat-value"><%= applications.filter(function(a){return a.documents.length > 0}).length %></div><div class="stat-label">Apps with Documents</div></div>
      </div>
      <div class="stat-card">
        <div class="card-icon navy" style="background:rgba(94,0,6,0.3);width:44px;height:44px;font-size:1.1rem;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload-icon lucide-upload"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg></div>
        <div><div class="stat-value"><%= new Date().getMonth() === new Date(documents.length > 0 ? documents[0].created_at : Date.now()).getMonth() ? documents.filter(function(d){return new Date(d.created_at).getMonth() === new Date().getMonth()}).length : 0 %></div><div class="stat-label">Uploaded This Month</div></div>
      </div>
      <div class="stat-card">
        <div class="card-icon blue" style="background:rgba(94,0,6,0.3);width:44px;height:44px;font-size:1.1rem;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FCFFFD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check-icon lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg></div>
        <div><div class="stat-value"><%= applications.length - applications.filter(function(a){return a.documents.length > 0}).length %></div><div class="stat-label">Apps Missing Docs</div></div>
      </div>
    </div>

    <% if (applications.length > 0) { %>
    <div class="card mb-32">
      <div class="card-header"><h3>Upload Document</h3></div>
      <form id="uploadForm" method="POST" enctype="multipart/form-data">
        <div class="form-row">
          <div class="form-group">
            <label>Application <span class="required">*</span></label>
            <select class="form-control" id="appSelect" required>
              <option value="">-- Select Application --</option>
              <% activeApps.forEach(function(app) { %>
              <option value="<%= app.id %>"><%= app.program.name %> <% if (app.academic_year) { %>(<%= app.academic_year %>)<% } %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Document Type <span class="required">*</span></label>
            <select class="form-control" id="docTypeSelect" required>
              <option value="">-- Select Type --</option>
              <option value="Report Card">Report Card / Grades</option>
              <option value="Enrollment Certificate">Certificate of Enrollment</option>
              <option value="Good Moral">Good Moral Certificate</option>
              <option value="Birth Certificate">Birth Certificate</option>
              <option value="Application Form">Application Form</option>
              <option value="Recommendation">Recommendation Letter</option>
              <option value="Essay">Personal Essay</option>
              <option value="Income Document">Income / Financial Document</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>File <span class="required">*</span></label>
          <div class="file-upload-area" id="dropArea">
            <div class="upload-icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload-cloud-icon lucide-upload-cloud"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m16 16-4-4-4 4"/></svg></div>
            <p><strong>Click to upload</strong> or drag and drop</p>
            <p style="font-size:.78rem;margin-top:4px;">PDF, JPG, PNG, or WEBP (max 10MB)</p>
            <input type="file" id="fileInput" accept=".pdf,.jpg,.jpeg,.png,.webp" style="display:none;" />
          </div>
          <div class="file-list" id="fileList"></div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg" id="uploadBtn">Upload Document</button>
      </form>
    </div>

    <div class="card">
      <div class="card-header"><h3>Documents by Application</h3></div>
      <% applications.forEach(function(app) { %>
      <div style="margin-bottom:20px;border:1px solid var(--border);border-radius:12px;overflow:hidden;">
        <div class="flex justify-between items-center" style="padding:16px 20px;background:var(--slate);border-bottom:1px solid var(--border);">
          <div>
            <strong style="font-size:.95rem;"><%= app.program.name %></strong>
            <span style="font-size:.8rem;color:var(--muted);margin-left:12px;"><%= app.academic_year || '--' %> &middot; <%= app.semester || '--' %></span>
          </div>
          <div class="flex gap-8 items-center">
            <span class="badge badge-<%= app.status === 'approved' ? 'approved' : app.status === 'rejected' ? 'rejected' : app.status === 'review' ? 'review' : 'pending' %>"><%= app.status %></span>
            <span style="font-size:.8rem;color:var(--muted);"><%= app.documents.length %> file(s)</span>
          </div>
        </div>
        <% if (app.documents.length > 0) { %>
        <div style="padding:8px 20px;">
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);">
                <th style="padding:10px 8px 6px;text-align:left;">File Name</th>
                <th style="padding:10px 8px 6px;text-align:left;">Type</th>
                <th style="padding:10px 8px 6px;text-align:left;">Size</th>
                <th style="padding:10px 8px 6px;text-align:left;">Uploaded</th>
              </tr>
            </thead>
            <tbody>
              <% app.documents.forEach(function(doc) { %>
              <tr style="border-top:1px solid var(--panel);">
                <td style="padding:10px 8px;font-size:.85rem;">
                  <span style="display:flex;align-items:center;gap:8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-icon lucide-file"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                    <%= doc.file_name %>
                  </span>
                </td>
                <td style="padding:10px 8px;font-size:.8rem;color:var(--muted);"><%= doc.doc_type %></td>
                <td style="padding:10px 8px;font-size:.8rem;color:var(--muted);"><%= doc.file_size_kb >= 1024 ? (doc.file_size_kb / 1024).toFixed(1) + ' MB' : doc.file_size_kb + ' KB' %></td>
                <td style="padding:10px 8px;font-size:.8rem;color:var(--muted);"><%= new Date(doc.created_at).toLocaleDateString() %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div style="padding:24px 20px;text-align:center;color:var(--muted);font-size:.85rem;">
          No documents uploaded for this application.
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="card">
      <div class="empty-state">
        <div class="empty-icon"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-open-icon lucide-folder-open"><path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/></svg></div>
        <h3>No Applications Yet</h3>
        <p>You need to submit a scholarship application before you can upload documents.</p>
        <a href="/portal/application" class="btn btn-primary">Apply Now</a>
      </div>
    </div>
    <% } %>
  </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const dropArea = document.getElementById('dropArea');
  const fileInput = document.getElementById('fileInput');
  const fileList = document.getElementById('fileList');
  const uploadForm = document.getElementById('uploadForm');
  const uploadBtn = document.getElementById('uploadBtn');

  dropArea.addEventListener('click', function() { fileInput.click(); });

  dropArea.addEventListener('dragover', function(e) {
    e.preventDefault();
    dropArea.classList.add('dragover');
  });
  dropArea.addEventListener('dragleave', function() {
    dropArea.classList.remove('dragover');
  });
  dropArea.addEventListener('drop', function(e) {
    e.preventDefault();
    dropArea.classList.remove('dragover');
    if (e.dataTransfer.files.length) {
      fileInput.files = e.dataTransfer.files;
      showFile(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', function() {
    if (this.files.length) showFile(this.files[0]);
  });

  function showFile(file) {
    const size = file.size >= 1024 * 1024 ? (file.size / (1024 * 1024)).toFixed(1) + ' MB' : (file.size / 1024).toFixed(0) + ' KB';
    fileList.innerHTML = '<div class="file-item"><span class="file-name"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-icon lucide-file"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg> ' + file.name + ' <span style="color:var(--muted);font-size:.75rem;">(' + size + ')</span></span><button type="button" class="remove-file" onclick="this.parentElement.remove();document.getElementById(\'fileInput\').value=\'\'">&times;</button></div>';
  }

  uploadForm.addEventListener('submit', function(e) {
    e.preventDefault();
    const appId = document.getElementById('appSelect').value;
    const docType = document.getElementById('docTypeSelect').value;
    const file = fileInput.files[0];

    if (!appId) { alert('Please select an application.'); return; }
    if (!docType) { alert('Please select a document type.'); return; }
    if (!file) { alert('Please select a file.'); return; }

    const formData = new FormData();
    formData.append('application_id', appId);
    formData.append('doc_type', docType);
    formData.append('file', file);

    uploadBtn.disabled = true;
    uploadBtn.textContent = 'Uploading...';

    fetch('/documents/upload', { method: 'POST', body: formData })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) { alert(data.error); return; }
        window.location.href = '/portal/documents?message=Document uploaded successfully.';
      })
      .catch(function() {
        alert('Upload failed. Please try again.');
      })
      .finally(function() {
        uploadBtn.disabled = false;
        uploadBtn.textContent = 'Upload Document';
      });
  });
});
</script>
</body>
</html>