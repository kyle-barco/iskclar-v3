generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model students {
  id                String   @id @default(uuid()) @db.Uuid
  username          String   @unique
  last_name         String
  first_name        String
  middle_name       String?
  suffix            String?
  date_of_birth     DateTime
  sex               String
  civil_status      String   @default("Single")
  nationality       String   @default("Filipino")
  contact_number    String
  email             String
  addr_street       String
  addr_barangay     String
  addr_municipality String
  addr_province     String
  addr_zip          String
  student_id        String?
  year_level        Int?
  college           String?
  degree_program    String?
  gpa               Decimal?
  enrolled_units    Int?
  father_name       String?
  father_occ        String?
  mother_name       String?
  mother_occ        String?
  profile_photo     String?
  password_hash     String
  created_at        DateTime @default(now()) @db.Timestamptz
  is_deleted        Boolean  @default(false)
  deleted_at        DateTime? @db.Timestamptz

  applications applications[]

  @@map("students")
}

model admins {
  id            String  @id @default(uuid()) @db.Uuid
  email         String  @unique
  password_hash String
  role          String
  is_active     Boolean @default(true)
  display_name  String

  applications           applications[]
  notifications_created  notifications[] @relation("notification_creator")
  notifications_approved notifications[] @relation("notification_approver")
  activity_logs          activity_logs[]
  deletion_requests_created  scholarship_programs[] @relation("deletion_requester")
  deletion_requests_approved scholarship_programs[] @relation("deletion_approver")

  @@map("admins")
}

model scholarship_programs {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  description       String   @default("")
  slots             Int?
  gpa_requirement   Decimal?
  application_start DateTime
  application_end   DateTime
  academic_year     String?
  semester          String?
  type              String   @default("public")
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  deleted_at        DateTime? @db.Timestamptz
  deletion_requested_by String? @db.Uuid
  deletion_requested_at DateTime? @db.Timestamptz
  deletion_approved_by  String? @db.Uuid
  deletion_approved_at  DateTime? @db.Timestamptz

  deletion_requester admins? @relation("deletion_requester", fields: [deletion_requested_by], references: [id])
  deletion_approver  admins? @relation("deletion_approver", fields: [deletion_approved_by], references: [id])
  applications applications[]

  @@map("scholarship_programs")
}

model applications {
  id            String    @id @default(uuid()) @db.Uuid
  student_id    String    @db.Uuid
  program_id    String    @db.Uuid
  status        String    @default("pending")
  remarks       String?
  reviewed_by   String?   @db.Uuid
  reviewed_at   DateTime? @db.Timestamptz
  academic_year String?
  semester      String?
  created_at    DateTime  @default(now()) @db.Timestamptz
  is_deleted    Boolean   @default(false)
  deleted_at    DateTime? @db.Timestamptz

  student   students             @relation(fields: [student_id], references: [id])
  program   scholarship_programs @relation(fields: [program_id], references: [id])
  reviewer  admins?              @relation(fields: [reviewed_by], references: [id])
  documents documents[]

  @@map("applications")
}

model documents {
  id             String   @id @default(uuid()) @db.Uuid
  application_id String   @db.Uuid
  doc_type       String
  file_path      String
  file_name      String
  mime_type      String
  file_size_kb   Int
  created_at     DateTime @default(now()) @db.Timestamptz

  application applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("documents")
}

model notifications {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  message         String
  status          String    @default("pending")
  created_by      String    @db.Uuid
  approved_by     String?   @db.Uuid
  rejected_at     DateTime? @db.Timestamptz
  rejection_reason String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  creator  admins @relation("notification_creator", fields: [created_by], references: [id], onDelete: Cascade)
  approver admins? @relation("notification_approver", fields: [approved_by], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model school_events {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  event_date  DateTime @db.Date
  end_date    DateTime? @db.Date
  color       String   @default("#2e7d32")
  type        String   @default("application")
  created_at  DateTime @default(now()) @db.Timestamptz
  created_by  String?  @db.Uuid

  @@map("school_events")
}

model activity_logs {
  id          String   @id @default(uuid()) @db.Uuid
  admin_id    String   @db.Uuid
  action      String
  target_type String?
  target_id   String?
  details     String?
  created_at  DateTime @default(now()) @db.Timestamptz

  admin admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
